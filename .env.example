# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Backend URL (e.g. https://your-app.onrender.com)
# For local dev/preview, leave empty to use current origin.
VITE_API_BASE_URL=""

# Email Configuration for Contact Form
# Specify receiver email address
SUPPORT_EMAIL="support@gravityverse.in"

# Resend API Key for dispatching emails.
# Sign up at https://resend.com to get an API key.
RESEND_API_KEY=""

# Google Analytics 4 (GA4) Measurement ID
# Set this variable in the Secrets Panel in AI Studio or local .env to enable production tracking
VITE_GA_MEASUREMENT_ID=""

# OPENROUTER_API_KEY: Optional secondary AI provider API key.
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# TAVILY_API_KEY: Tavily Web Search API key for live search results.
# Get your API key from https://tavily.com
TAVILY_API_KEY=""

# ALLOWED_ORIGINS: Optional comma-separated list of additional allowed CORS frontend origins.
ALLOWED_ORIGINS="https://gravityverse.in,https://www.gravityverse.in"

# Administrator Email for SRM Events and Content Management
ADMIN_EMAIL="satyamanikantareddysathi@gmail.com"

# Cron Secret for securing background /api/srm-events/cron-update trigger
CRON_SECRET=""
